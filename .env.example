# Memoratum configuration template. Every variable is optional; the defaults
# below are what the code uses when the variable is unset. The server reads the
# environment directly — nothing here needs to be copied into a file.

# --- core -------------------------------------------------------------------
# Where the SQLite database, the auto-generated webhook key, and any local
# vector-store path live. Created 0700 if absent.
MEMORATUM_DATA_DIR=./.memoratum-data
# Admin Bearer key. Unset on first boot mints a wildcard admin key and prints it
# once. With this unset the server treats the deployment as UNAUTHENTICATED and
# every admin endpoint is open — set it for anything reachable.
MEMORATUM_API_KEY=
# Labels the deployment. `development` is required before
# MEMORATUM_WEBHOOK_ALLOW_PRIVATE_TARGETS can take effect.
MEMORATUM_ENV=production

# --- embeddings -------------------------------------------------------------
# provider=hash (offline dev) or api (OpenAI-compatible).
MEMORATUM_EMBEDDINGS_PROVIDER=hash
MEMORATUM_EMBEDDINGS_ENDPOINT=http://localhost:11434/v1
MEMORATUM_EMBEDDINGS_MODEL=nomic-embed-text
MEMORATUM_EMBEDDINGS_DIMS=0
MEMORATUM_EMBEDDINGS_KEY=

# --- chat / dreaming --------------------------------------------------------
# Unset endpoint/model = dreaming (LLM fact extraction) is skipped.
MEMORATUM_LLM_PROVIDER=openai
MEMORATUM_LLM_ENDPOINT=
MEMORATUM_LLM_MODEL=
MEMORATUM_LLM_KEY=

# --- reranking (optional) ----------------------------------------------------
# heuristic (default, no dependency) or a rerank provider.
MEMORATUM_RERANKER=heuristic
MEMORATUM_RERANKER_MODEL=
MEMORATUM_RERANKER_ENDPOINT=
MEMORATUM_RERANKER_KEY=

# --- vector store -----------------------------------------------------------
# sqlite is the default and needs no extra. The others require the matching
# optional dependency: `uv pip install '.[qdrant]'` / `.[chroma]` / `.[pgvector]`.
MEMORATUM_VECTOR_STORE=sqlite
MEMORATUM_VECTOR_STORE_ENDPOINT=
MEMORATUM_VECTOR_STORE_PATH=
MEMORATUM_VECTOR_STORE_COLLECTION=memoratum
# Must match the embedder's output width or writes fail. 0 = follow embeddings.
MEMORATUM_VECTOR_STORE_DIMS=0
MEMORATUM_VECTOR_STORE_KEY=

# --- webhooks ---------------------------------------------------------------
# Fernet key used to encrypt signing secrets at rest. Comma-separated values are
# accepted so a key can be rotated in without downtime: the first is used for new
# writes, the rest still decrypt older rows. Unset generates a mode-600
# `.webhook-encryption-key` in MEMORATUM_DATA_DIR. LOSING THIS KEY MAKES EXISTING
# WEBHOOK SECRETS UNRECOVERABLE.
MEMORATUM_WEBHOOK_ENCRYPTION_KEY=
# Development-only. Permits http:// and private/loopback/link-local targets,
# which disables the entire outbound address policy. Ignored unless
# MEMORATUM_ENV is development or test.
MEMORATUM_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# --- worker -----------------------------------------------------------------
# Seconds between polls when the queue is empty.
MEMORATUM_WORKER_INTERVAL=2
# Lease length for a claimed job. A worker killed uncatchably (SIGKILL, OOM)
# leaves its job stranded until this expires and the reaper recovers it. Raise it
# for very long single-item jobs; it must exceed the slowest unit of work between
# heartbeats, not the whole batch. Clamped to 30..86400.
MEMORATUM_JOB_LEASE_SECONDS=300
# 0 disables the automatic daily retention sweep. Silently deleting audit or
# memory-history data is a worse failure than a growing database file, so nothing
# is deleted automatically until you opt in. See docs/OPERATIONS.md.
MEMORATUM_RETENTION_DAYS=0

# --- observability ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Log records carry scope identifiers only,
# never memory content, secrets, or API keys.
MEMORATUM_LOG_LEVEL=INFO
# json for container log drivers, text for human reading.
MEMORATUM_LOG_FORMAT=json
# GET /metrics is loopback-bound either way; this only controls whether the
# instrumentation runs.
MEMORATUM_METRICS_ENABLED=true

# --- request validation -----------------------------------------------------
# false (default) rejects unknown request fields with 422. true restores the old
# ignore-extras behaviour for clients that send extra fields — and logs a loud
# warning at startup, because a misspelled project_id then writes to global scope.
MEMORATUM_LENIENT_COMPAT=false

# --- enterprise identity (optional) ----------------------------------------
MEMORATUM_OIDC_ISSUER=
MEMORATUM_OIDC_AUDIENCE=
MEMORATUM_OIDC_JWKS_URL=

# --- dashboard --------------------------------------------------------------
# Serve a prebuilt dashboard from here (npm run build inside dashboard/).
MEMORATUM_DASHBOARD_DIR=