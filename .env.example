# Memoratum configuration template. Copy nothing — the server reads the
# environment directly. Every variable is optional; see README for defaults.
MEMORATUM_DATA_DIR=./.memoratum-data
# Admin Bearer key. Unset on first boot mints and prints a wildcard key once.
MEMORATUM_API_KEY=
# Embeddings: provider=hash (offline dev) or api (OpenAI-compatible).
MEMORATUM_EMBEDDINGS_PROVIDER=hash
MEMORATUM_EMBEDDINGS_ENDPOINT=http://localhost:11434/v1
MEMORATUM_EMBEDDINGS_MODEL=nomic-embed-text
MEMORATUM_EMBEDDINGS_DIMS=0
MEMORATUM_EMBEDDINGS_KEY=
# Chat endpoint for dreaming (fact extraction). Unset = dreaming skipped.
MEMORATUM_LLM_ENDPOINT=
MEMORATUM_LLM_MODEL=
MEMORATUM_LLM_KEY=
# Serve a prebuilt dashboard/ here (npm run build inside dashboard/).
MEMORATUM_DASHBOARD_DIR=
